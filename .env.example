# Optional: Gemini is NOT required for bulk mode.
# If set, `python main.py --bulk --count 1000 --llm` may use Gemini
# only when the remaining request budget can accommodate all summary batches.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

MAX_RUNTIME_SECONDS=2700
MAX_OUTBOUND_REQUESTS=2000
MAX_COST_USD=10.0
BULK_MAX_RUNTIME_SECONDS=2700
BULK_MAX_OUTBOUND_REQUESTS=2000
BULK_MAX_COST_USD=10.0
